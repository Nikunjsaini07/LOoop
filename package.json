{
  "name": "readwell",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "semantic:index": "node scripts/semantic-index.mjs --local",
    "semantic:watch": "node scripts/semantic-index.mjs --local --watch",
    "semantic:status": "node scripts/semantic-index.mjs --local --status",
    "test": "node --experimental-strip-types --test components/*.test.mjs lib/*.test.mjs lib/server/*.test.mjs backend/*.test.mjs scripts/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "production:check": "node scripts/production.mjs check",
    "build:production": "node scripts/production.mjs build",
    "deploy:check": "node scripts/production.mjs dry-run",
    "deploy": "node scripts/production.mjs deploy",
    "dev:backend": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config wrangler.jsonc --local --persist-to .wrangler/state --ip 127.0.0.1 --port 8787 --inspector-port 0",
    "build:backend": "node scripts/production.mjs build",
    "deploy:backend:check": "node scripts/production.mjs dry-run",
    "deploy:backend": "node scripts/production.mjs deploy"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/react": "^6.17.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@huggingface/transformers": "4.3.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
