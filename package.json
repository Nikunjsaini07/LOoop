{
  "name": "readwell",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "semantic:index": "node scripts/semantic-index.mjs --local",
    "semantic:watch": "node scripts/semantic-index.mjs --local --watch",
    "semantic:status": "node scripts/semantic-index.mjs --local --status",
    "test": "node --experimental-strip-types --test components/*.test.mjs lib/*.test.mjs lib/server/*.test.mjs scripts/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "production:check": "node scripts/production.mjs check",
    "build:production": "node scripts/production.mjs build",
    "deploy:check": "node scripts/production.mjs dry-run",
    "deploy": "node scripts/production.mjs deploy",
    "release:source": "python scripts/package-release.py"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/react": "^6.17.8",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@huggingface/transformers": "4.3.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "esbuild": "0.28.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
