# Local development only. Never commit .env.local or private keys.
# Run node scripts/setup-local.mjs to add the private local API connection.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_FROM_CLERK
CLERK_SECRET_KEY=sk_test_REPLACE_FROM_CLERK
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173,http://localhost:5173
# Vercel uses these three settings (configure them in its dashboard):
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your Clerk production public key
# READWELL_API_URL=https://readwell-api.YOUR_SUBDOMAIN.workers.dev
# READWELL_PROXY_SECRET=the same random secret set on the API Worker
# Cloudflare account IDs, API tokens and Clerk secret keys are not needed on Vercel.
