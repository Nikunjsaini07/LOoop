# Copy this file to .env.local for local Next.js development.
# Keep .env.local, .dev.vars, and all real credentials private.

# Supabase Authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Local Cloudflare Worker API
READWELL_API_URL=http://127.0.0.1:8787
READWELL_PROXY_SECRET=replace-with-the-same-secret-used-in-dev-vars

# Optional PostgreSQL connection for the Neon adapter.
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
