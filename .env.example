# Local development only. Never commit .env.local or private keys.
# Run node scripts/setup-local.mjs to add the private local API connection.

# Supabase Authentication (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database (Required for production with Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Vercel Deployment Settings (configure in Vercel dashboard):
# NEXT_PUBLIC_SUPABASE_URL=your production Supabase URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your production Supabase anon key
# READWELL_API_URL=https://readwell-api.YOUR_SUBDOMAIN.workers.dev
# READWELL_PROXY_SECRET=the same random secret set on the API Worker
# DATABASE_URL=your production database connection string
