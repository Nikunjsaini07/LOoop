{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "readwell-api-local",
  "main": "workers/api.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:5173",
    "DATABASE_URL": "postgresql://neondb_owner:npg_SiuWdC4OosL3@ep-frosty-dream-b584g56d-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
  },
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "d1_databases": [{
    "binding": "DB",
    // Keep this identity: the existing local archive is stored under this ID.
    "database_name": "site-creator-d1",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "drizzle"
  }]
}
