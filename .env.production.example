# Copy to .env.production; this file contains public build settings only.
# In hosted CI, set these same values as build environment variables instead.
# Configure the matching public variables in Vercel. Set private Worker secrets
# with Wrangler or in your CI secret store; do not put them in this file.

READWELL_DEPLOYMENT_MODE=production
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_32_CHARACTER_ACCOUNT_ID
CLOUDFLARE_D1_DATABASE_ID=REPLACE_WITH_EXISTING_READS_DATABASE_UUID
CLOUDFLARE_D1_DATABASE_NAME=reads
READWELL_WORKER_NAME=readwell-api
APP_ORIGIN=https://readwell.your-domain.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Set READWELL_PROXY_SECRET and SUPABASE_SERVICE_ROLE_KEY as Worker secrets.
# Keep CLOUDFLARE_API_TOKEN in the CI secret store or use wrangler login locally.
